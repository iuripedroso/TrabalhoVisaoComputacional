    def _generate_comparison(self, m207: dict, m309: dict) -> str:
        lines = []

        def _cmp(label, key, higher_is="maior"):
            v207 = m207[key]; v309 = m309[key]
            ratio = v207 / v309 if v309 > 0 else float("inf")
            bigger = "b0207" if v207 > v309 else "b0309"
            pct = abs(ratio - 1) * 100
            lines.append(
                f"  • {label}: {bigger} é {pct:.1f}% {'maior' if v207 > v309 == (higher_is=='maior') else 'diferente'}"
                f" ({v207:.2f} vs {v309:.2f})"
            )

        _cmp("Volume",        "volume_voxels")
        _cmp("Área superf.",  "area_superficie")
        _cmp("Compacidade",   "compacidade",  "menor")
        _cmp("Excentricidade","excentricidade")
        _cmp("Comprimento skel.", "skel_total_voxels")
        _cmp("Pontos de ramo","skel_branch_points")
        _cmp("Pontas terminais","skel_tip_points")
        _cmp("Densidade skel.","skel_density")
        _cmp("Alongamento",   "skel_elongation")
        _cmp("Tortuosidade",  "skel_tortuosity")
        _cmp("Segmentos",     "skel_segments")

        # análise qualitativa
        vol_diff   = m207["volume_voxels"]  / max(m309["volume_voxels"], 1)
        branch_207 = m207["skel_branch_points"]
        branch_309 = m309["skel_branch_points"]
        elon_207   = m207["skel_elongation"]
        elon_309   = m309["skel_elongation"]

        lines.append("")
        lines.append("  Interpretação geral:")
        if vol_diff > 1.2:
            lines.append("  → b0207 possui volume significativamente maior, indicando uma")
            lines.append("    raiz mais robusta ou com maior massa de tecido.")
        elif vol_diff < 0.8:
            lines.append("  → b0309 possui volume significativamente maior.")
        else:
            lines.append("  → Os volumes são comparáveis entre as duas raízes.")

        if branch_207 > branch_309 * 1.2:
            lines.append("  → b0207 tem mais pontos de ramificação, sugerindo arquitetura")
            lines.append("    radicular mais complexa / mais ramificada.")
        elif branch_309 > branch_207 * 1.2:
            lines.append("  → b0309 tem mais pontos de ramificação (maior complexidade).")

        if elon_207 > elon_309:
            lines.append("  → b0207 é mais alongada (raiz mais vertical/linear).")
        else:
            lines.append("  → b0309 é mais alongada (raiz mais vertical/linear).")

        comp207 = m207["compacidade"]; comp309 = m309["compacidade"]
        if comp207 > comp309:
            lines.append("  → b0207 é mais compacta (morfologia mais esférica/globosa).")
        else:
            lines.append("  → b0309 é mais compacta (morfologia mais esférica/globosa).")

        return "\n".join(lines)


