import os
import sys
import io
import zipfile
import threading
import tkinter as tk
from tkinter import ttk, filedialog, messagebox, scrolledtext
import numpy as np
from PIL import Image
import pyvista as pv
from skimage import measure, morphology, filters
from skimage.morphology import skeletonize_3d
from scipy import ndimage

# ---------------------------------------------------------------------------
# Constantes / configurações globais
# ---------------------------------------------------------------------------
BORDER_CLEAN = 5          # pixels a zerar nas bordas externas de cada fatia
ISO_VALUE    = 0.5        # valor padrão da isosuperfície (0..1 após normalização)
SMOOTH_ITER  = 50         # iterações de suavização Laplaciana
DECIMATE_T   = 0.70       # fração de decimação (0..1)

# ---------------------------------------------------------------------------
# Utilitários
# ---------------------------------------------------------------------------

def load_images_from_zip(zip_path: str) -> np.ndarray:
    """Extrai e empilha todas as imagens PNG de um ZIP em um volume 3-D uint8."""
    with zipfile.ZipFile(zip_path) as z:
        names = sorted(n for n in z.namelist() if n.lower().endswith(".png"))
        slices = []
        for name in names:
            data = z.read(name)
            img  = Image.open(io.BytesIO(data)).convert("L")   # grayscale
            slices.append(np.array(img, dtype=np.uint8))
    return np.stack(slices, axis=0)   # shape: (Z, Y, X)


def clean_borders(volume: np.ndarray, border: int = BORDER_CLEAN) -> np.ndarray:
    """Zera os pixels das bordas externas de cada fatia (XY) e dos extremos Z."""
    vol = volume.copy()
    # bordas laterais (XY)
    vol[:, :border, :]  = 0
    vol[:, -border:, :] = 0
    vol[:, :, :border]  = 0
    vol[:, :, -border:] = 0
    # bordas Z (primeiras e últimas fatias)
    vol[:border, :, :]  = 0
    vol[-border:, :, :] = 0
    return vol


def volume_to_pyvista(volume: np.ndarray) -> pv.ImageData:
    """Converte ndarray (Z,Y,X) para pv.ImageData com escalares escalar=intensidade."""
    grid = pv.ImageData()
    grid.dimensions = (volume.shape[2], volume.shape[1], volume.shape[0])
    flat = volume.transpose(2, 1, 0).ravel(order="F").astype(np.float32)
    flat = flat / flat.max() if flat.max() > 0 else flat
    grid.point_data["scalars"] = flat
    return grid


# ---------------------------------------------------------------------------
# Pipeline de processamento
# ---------------------------------------------------------------------------

class RootData:
    """Armazena dados processados de uma raiz."""

    def __init__(self, name: str, zip_path: str, log_fn=None):
        self.name     = name
        self.zip_path = zip_path
        self._log     = log_fn or print
        self.volume_raw   = None   # uint8
        self.volume_clean = None   # uint8, bordas limpas
        self.grid         = None   # pv.ImageData
        self.iso_mesh     = None   # isosuperfície bruta
        self.iso_smooth   = None   # isosuperfície suavizada
        self.iso_decim    = None   # isosuperfície decimada
        self.skel_lines   = None   # pv.PolyData skeleton
        self.metrics      = {}

    # -----------------------------------------------------------------------
    def load(self):
        self._log(f"[{self.name}] Carregando imagens de {os.path.basename(self.zip_path)} ...")
        self.volume_raw   = load_images_from_zip(self.zip_path)
        self.volume_clean = clean_borders(self.volume_raw, BORDER_CLEAN)
        self._log(f"[{self.name}] Volume: {self.volume_clean.shape} — "
                  f"bordas limpas ({BORDER_CLEAN}px)")
        self.grid = volume_to_pyvista(self.volume_clean)

    # -----------------------------------------------------------------------
    def compute_isosurface(self, iso_val: float = ISO_VALUE,
                           smooth_iter: int = SMOOTH_ITER,
                           decimate_target: float = DECIMATE_T):
        self._log(f"[{self.name}] Gerando isosuperfície (iso={iso_val:.2f}) ...")
        # marching cubes via pyvista
        self.iso_mesh = self.grid.contour([iso_val], scalars="scalars")
        n_raw = self.iso_mesh.n_cells
        self._log(f"[{self.name}] Isosuperfície bruta: {n_raw} faces")

        self._log(f"[{self.name}] Suavizando (iters={smooth_iter}) ...")
        self.iso_smooth = self.iso_mesh.smooth(n_iter=smooth_iter,
                                               relaxation_factor=0.1,
                                               boundary_smoothing=True)

        self._log(f"[{self.name}] Decimando (alvo={decimate_target*100:.0f}% redução) ...")
        self.iso_decim = self.iso_smooth.decimate(decimate_target)
        n_dec = self.iso_decim.n_cells
        self._log(f"[{self.name}] Isosuperfície decimada: {n_dec} faces "
                  f"({100*n_dec/n_raw:.1f}% do original)")

    # -----------------------------------------------------------------------
    def compute_skeleton(self):
        self._log(f"[{self.name}] Computando esqueleto 3D (skimage) ...")
        vol_norm = (self.volume_clean / 255.0)
        # binariza com Otsu
        thresh  = filters.threshold_otsu(vol_norm[vol_norm > 0])
        binary  = vol_norm > thresh
        # remove pequenos objetos
        binary  = morphology.remove_small_objects(binary, min_size=64)
        binary  = morphology.binary_closing(binary, morphology.ball(1))
        skel    = skeletonize_3d(binary).astype(bool)
        self._log(f"[{self.name}] Esqueleto: {skel.sum()} voxels")
        # converte para linhas PyVista
        coords  = np.argwhere(skel).astype(float)   # (N,3) em ordem Z,Y,X
        coords  = coords[:, [2, 1, 0]]              # → X,Y,Z
        if len(coords) < 2:
            self.skel_lines = pv.PolyData()
            return
        cloud   = pv.PolyData(coords)
        self.skel_lines = cloud
        # guarda volume binário para métricas
        self._skel_binary = skel
        self._binary      = binary

    # -----------------------------------------------------------------------
    def compute_metrics(self):
        self._log(f"[{self.name}] Calculando métricas ...")
        mesh = self.iso_decim

        # --- volume (contagem de voxels binários × volume de voxel)
        vox_vol   = 1.0   # assumimos espaçamento unitário
        vol_voxel = self._binary.sum() * vox_vol
        self.metrics["volume_voxels"] = float(vol_voxel)

        # --- área de superfície (soma das áreas das faces da malha)
        surf_area = mesh.area
        self.metrics["area_superficie"] = float(surf_area)

        # --- compacidade = (36π V²) / A³
        V = vol_voxel;  A = surf_area
        compacity = (36 * np.pi * V**2) / (A**3) if A > 0 else 0.0
        self.metrics["compacidade"] = float(compacity)

        # --- excentricidade via momentos de inércia dos voxels binários
        coords = np.argwhere(self._binary).astype(float)
        if len(coords) > 3:
            centroid = coords.mean(axis=0)
            diff     = coords - centroid
            cov      = (diff.T @ diff) / len(coords)
            eigvals  = np.linalg.eigvalsh(cov)
            eigvals  = np.sort(np.abs(eigvals))[::-1]
            if eigvals[0] > 0:
                eccentricity = np.sqrt(1 - eigvals[-1] / eigvals[0])
            else:
                eccentricity = 0.0
            self.metrics["excentricidade"] = float(eccentricity)
        else:
            self.metrics["excentricidade"] = 0.0

        # --- métricas de esqueleto ---
        skel = self._skel_binary
        # 1) comprimento total (nº voxels)
        self.metrics["skel_total_voxels"] = int(skel.sum())

        # 2) número de pontos de ramificação (vizinhos 26-conectados > 2)
        struct = ndimage.generate_binary_structure(3, 3)  # 26-connect
        neighbor_count = ndimage.convolve(skel.astype(np.int32), struct.astype(np.int32))
        branch_pts = ((neighbor_count > 3) & skel)
        self.metrics["skel_branch_points"] = int(branch_pts.sum())

        # 3) número de pontos de terminal (apenas 1 vizinho no esqueleto)
        tip_pts = ((neighbor_count == 2) & skel)   # 2 porque inclui o próprio
        self.metrics["skel_tip_points"] = int(tip_pts.sum())

        # 4) densidade do esqueleto = nº voxels skel / nº voxels binário
        density = skel.sum() / max(self._binary.sum(), 1)
        self.metrics["skel_density"] = float(density)

        # 5) bounding-box ratio (comprimento/largura) → alongamento
        z_idx, y_idx, x_idx = np.where(skel)
        if len(z_idx) > 0:
            dz = z_idx.max() - z_idx.min() + 1
            dy = y_idx.max() - y_idx.min() + 1
            dx = x_idx.max() - x_idx.min() + 1
            elongation = max(dz, dy, dx) / max(min(dz, dy, dx), 1)
        else:
            elongation = 0.0
        self.metrics["skel_elongation"] = float(elongation)

        # 6) tortuosidade média
        # estimada via comprimento do esqueleto / distância de bounding box diagonal
        diag = np.sqrt(dz**2 + dy**2 + dx**2) if len(z_idx) > 0 else 1
        tortuosity = skel.sum() / max(diag, 1)
        self.metrics["skel_tortuosity"] = float(tortuosity)

        # 7) número estimado de segmentos (ramos)
        # Label da imagem do esqueleto sem pontos de ramificação
        skel_no_branch = skel.copy()
        skel_no_branch[branch_pts] = False
        labeled, n_segs = ndimage.label(skel_no_branch, structure=struct)
        self.metrics["skel_segments"] = int(n_segs)

        self._log(f"[{self.name}] Métricas calculadas.")

    # -----------------------------------------------------------------------
    def run_full_pipeline(self, iso_val=ISO_VALUE,
                          smooth_iter=SMOOTH_ITER,
                          decimate_target=DECIMATE_T):
        self.load()
        self.compute_isosurface(iso_val, smooth_iter, decimate_target)
        self.compute_skeleton()
        self.compute_metrics()


